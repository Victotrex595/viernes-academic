# ==============================================================================
# ARCHIVO DE CONFIGURACIÓN - V.I.E.R.N.E.S. PHONEAPP ACADEMIC
# Copia este archivo a '.env' y completa con tus credenciales:
#   cp .env.example .env
# ==============================================================================

# Pool de Claves de Google Gemini (puedes agregar cuentas gratuitas secundarias)
# El sistema rota automáticamente entre ellas en caso de agotar la cuota diaria (429)
GEMINI_API_KEY=tu_primera_clave_gemini_aqui
GEMINI_API_KEY_2=tu_segunda_clave_gemini_opcional
GEMINI_API_KEY_3=tu_tercera_clave_gemini_opcional

# Clave de DeepSeek (para razonamiento profundo con DeepSeek-R1 / deepseek-reasoner)
DEEPSEEK_API_KEY=tu_clave_deepseek_aqui

# URL del Web App de Google Apps Script para sincronización directa con Google Drive
GOOGLE_DRIVE_BRIDGE_URL=https://script.google.com/macros/s/TU_SCRIPT_ID/exec

# Credenciales de acceso al portal SAIA (Moodle PSM)
SAIA_USERNAME=tu_cedula_o_usuario
SAIA_PASSWORD=tu_contraseña_saia

# Dominio público para certificado SSL automático gratuito (Let's Encrypt vía Caddy)
# Ejemplo: DOMAIN=mi-viernes.duckdns.org
# Si no tienes dominio y accederás por la IP pública de Oracle Cloud, déjalo vacío:
DOMAIN=
